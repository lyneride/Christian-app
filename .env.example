# Copy to .env and adjust. Never commit .env.
# PostgreSQL – kostenlos z. B. bei Neon (neon.tech), Supabase oder Prisma Postgres; lokal: Postgres 16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bleibe"
# Secret used to sign session cookies and tokens (min. 32 random characters)
AUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL (used in e-mails and absolute links)
APP_URL="http://localhost:3000"
# E-mail: leave SMTP_* empty to log e-mails to the console in development
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Bleibe <noreply@example.org>"
# Secret for scheduled jobs (Reminders, Aufräumen): curl -H "Authorization: Bearer $CRON_SECRET" -X POST $APP_URL/api/cron/reminders
CRON_SECRET=""
# Profilbilder: auf Vercel automatisch gesetzt, sobald ein Blob-Store verbunden ist; lokal leer → Ablage unter public/uploads
BLOB_READ_WRITE_TOKEN=""
